#!/bin/sh

set -eu

if git diff --cached --quiet --diff-filter=ACM; then
  exit 0
fi

if ! command -v trufflehog >/dev/null 2>&1; then
  cat >&2 <<'EOF'
trufflehog is required for the pre-commit secret scan.

Install it with:
  brew install trufflehog

Or see:
  https://github.com/trufflesecurity/trufflehog
EOF
  exit 1
fi

TMPDIR=$(mktemp -d)
export TMPDIR
trap 'rm -rf "$TMPDIR"' EXIT HUP INT TERM

# Scan the exact staged file contents, not the working tree. This avoids both
# missing staged secrets after later edits and blocking on unrelated unstaged
# changes.
git diff --cached --name-only -z --diff-filter=ACM |
  xargs -0 -I {} sh -c '
    path=$1
    staged_path="$TMPDIR/$path"
    mkdir -p "$(dirname "$staged_path")"
    git show ":$path" >"$staged_path"
  ' sh {}

trufflehog --no-update filesystem "$TMPDIR" --results=verified,unknown --fail
