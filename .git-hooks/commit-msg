#!/bin/sh

set -eu

MSG_FILE="$1"

# First non-empty, non-comment line is the commit subject.
SUBJECT=$(grep -vE '^(#|$)' "$MSG_FILE" | head -n1)

# Skip subjects generated by git.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

# Conventional-commit format, matching gpu-health-backend:
#   <type>(<scope>): <subject> [(GPUHEALTH-####)]
PATTERN='^(feat|fix|perf|refactor|docs|chore|test|revert)(\([a-z0-9._/-]+\))?!?: .+( \(GPUHEALTH-[0-9]+(, GPUHEALTH-[0-9]+)*\))?$'

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
  cat >&2 <<EOF
Commit subject does not match the required format.

Got:
  $SUBJECT

Expected:
  <type>(<scope>): <subject> [(GPUHEALTH-####)]

Examples:
  feat(cli): add node list command (GPUHEALTH-1701)
  fix(sdk): handle empty service key (GPUHEALTH-2001)
  chore: update dependencies

Allowed types:
  feat, fix, perf, refactor, docs, chore, test, revert
EOF
  exit 1
fi
